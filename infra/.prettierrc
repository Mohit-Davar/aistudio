{
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "endOfLine": "lf",
  "plugins": ["prettier-plugin-sh"],
  "overrides": [
    {
      "files": ["Dockerfile*", "*.Dockerfile"],
      "options": {
        "parser": "dockerfile"
      }
    },
    {
      "files": ["*.yml", "*.yaml"],
      "options": {
        "tabWidth": 2,
        "singleQuote": false
      }
    },
    {
      "files": ["*.sh", "*.bash"],
      "options": {
        "parser": "sh",
        "tabWidth": 2
      }
    }
  ]
}
